# Persistence (SQLite by default — no cloud required)
DATABASE_URL="file:./prisma/dev.db"

# API
PARADOX_API_HOST=127.0.0.1
PARADOX_API_PORT=8787
PARADOX_LOG_LEVEL=info

# Auth — set AUTH_REQUIRED=true in any shared environment
AUTH_REQUIRED=true
JWT_SECRET=change-me-in-production-use-a-long-random-string
AUTH_BOOTSTRAP_EMAIL= your-email
AUTH_BOOTSTRAP_PASSWORD=your-strong-password

# Verification policy
MAX_VERIFICATION_ROUNDS=5
SELF_VERIFY_THRESHOLD=0.70
MAX_EVIDENCE_ITEMS=15
REQUEST_TIMEOUT_MS=15000

# LLM (OpenAI-compatible). Leave unset → NOT_CONFIGURED, heuristic extractors only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=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
LLM_MODEL_CLASSIFY=gpt-4o-mini
LLM_MODEL_EXTRACT=gpt-4o-mini
LLM_MODEL_REASON=gpt-4o-mini
LLM_MODEL_SYNTHESIZE=gpt-4o-mini
LLM_MODEL_FORECAST=gpt-4o-mini
LLM_MODEL_DECISION=gpt-4o-mini

# Optional paid/free-tier web search. Wikipedia is always used when network is available.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=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
WEB_SEARCH_BASE_URL=https://api.tavily.com

# Rate limit
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
